# =============================================================
#  Modelo de variáveis de ambiente (.env.example)
# =============================================================
# Alguns scripts (analysis_contigs/ e count_bases/) carregam suas
# configurações de um arquivo .env usando python-dotenv.
#
# ATENÇÃO ao local do arquivo: os scripts procuram o .env em
#   ../../samples/.env
# relativo ao próprio script, ou seja, em uma pasta "samples/"
# localizada DOIS níveis ACIMA do script — fora deste repositório.
# Exemplo de árvore esperada:
#
#   Amazon_AquaBio/
#   ├── samples/
#   │   └── .env              <-- crie o arquivo aqui
#   └── Bioinformatics_Scripts/
#       ├── analysis_contigs/analysis_contig.py
#       └── count_bases/main.py
#
# Copie este modelo para ../../samples/.env e preencha com os
# caminhos reais da sua máquina. NUNCA versione o .env real.
# =============================================================

# Diretório com os FASTA das montagens do NOVOPlasty (usado por analysis_contigs)
NOVOPLASTY_FASTA_PATH=/caminho/para/novoplasty/fasta/

# Diretório com os FASTA das montagens do Unicycler (usado por count_bases)
UNICYCLER_FASTA_PATH=/caminho/para/unicycler/fasta/

# Diretório base onde os resultados (CSV) serão gravados.
# Os scripts criam uma subpasta "Table/" dentro deste caminho.
# Inclua a barra final "/".
PATH_RESULTS=/caminho/para/resultados/

# Caminho para o arquivo .txt com a lista "SRA:ESPECIE" (usado por count_bases)
dict_SRA-Species_orderby_nameSpecies_az=/caminho/para/lista_sra_especies.txt
